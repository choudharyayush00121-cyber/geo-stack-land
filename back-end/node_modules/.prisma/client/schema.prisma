generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         String   @default("CITIZEN")
  mobile       String?  @default("")
  organization String?  @default("")
  district     String?  @default("Bengaluru Urban")
  state        String?  @default("Karnataka")
  createdAt    DateTime @default(now())

  activeSessions ActiveSession[]
  auditLogs      AuditLog[]
}

model Parcel {
  id                Int      @id @default(autoincrement())
  ulpin             String   @unique
  surveyNo          String
  district          String
  taluk             String
  village           String
  coordinates       Json
  center            Json
  areaSqFt          Float?
  areaAcres         Float?
  zoning            String?
  zoningCode        String?
  circleRatePerSqFt Float?
  marketValue       Float?
  propertyTaxAnnual Float?
  owner             Json?
  financial         Json?
  aiSurveillance    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DocumentRecord {
  id                   Int      @id @default(autoincrement())
  documentId           String   @unique
  documentType         String
  filename             String?
  ulpinTarget          String?
  ocrExtractedData     Json?
  aiVerificationResult Json?
  departmentSource     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model ActiveSession {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  resource  String?
  details   Json?
  createdAt DateTime @default(now())
}

model AgentTrace {
  id          String       @id @default(uuid())
  framework   String // LANGGRAPH, CREWAI, MASTRA
  ulpin       String
  status      String // SUCCESS, RUNNING, FAILED
  latencyMs   Int
  tokensUsed  Int
  spans       Json // Detailed trace spans for Langfuse / Phoenix
  stateDiff   Json?
  metadata    Json?
  createdAt   DateTime     @default(now())
  evalMetrics EvalMetric[]
}

model VectorKnowledge {
  id        String   @id @default(uuid())
  title     String
  category  String // LAND_LAW, COURT_PRECEDENT, DEED_STANDARD, ZONING_RULE
  content   String
  vectorDim Int      @default(384)
  embedding Json // Float vector array for cosine similarity search
  metadata  Json?
  createdAt DateTime @default(now())
}

model AgentMemory {
  id         String   @id @default(uuid())
  sessionId  String
  ulpin      String?
  memoryType String // SHORT_TERM_BUFFER, LONG_TERM_EPISODIC, ENTITY_MEMORY
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EvalMetric {
  id               String     @id @default(uuid())
  traceId          String
  trace            AgentTrace @relation(fields: [traceId], references: [id])
  framework        String // RAGAS, TRULENS
  faithfulness     Float // 0.0 to 1.0 (Ragas / TruLens Groundedness)
  groundedness     Float // 0.0 to 1.0
  contextRelevance Float // 0.0 to 1.0
  answerRelevance  Float // 0.0 to 1.0
  contextPrecision Float? // 0.0 to 1.0
  passedAll        Boolean    @default(true)
  metadata         Json?
  createdAt        DateTime   @default(now())
}
